+          path: |
+            ${{ runner.temp }}/plan.json
+            ${{ runner.temp }}/requests
+            ${{ runner.temp }}/budget.json
+            ${{ runner.temp }}/plan-budget.json
+          retention-days: 1
+          compression-level: 0
+          if-no-files-found: error
+  analyze:
+    needs: plan
+    if: needs.plan.outputs.count != '0'
