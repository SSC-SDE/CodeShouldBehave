+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with: {ref: '${{ github.workflow_sha }}', persist-credentials: false}
+      - env: {GH_TOKEN: '${{ github.token }}'}
+        run: python3 .codeshouldbehave/bootstrap.py --config .codeshouldbehave/public-ci.json --output "$RUNNER_TEMP/csb-engine"
+      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333
+        with:
+          name: csb-public-plan-${{ github.run_id }}-${{ github.run_attempt }}
+          path: ${{ runner.temp }}/plan
+          digest-mismatch: error
+      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333
+        with:
+          pattern: csb-public-handoff-*
+          path: ${{ runner.temp }}/handoffs
+          merge-multiple: false
+          digest-mismatch: error
+      - name: Start one trusted publisher with its durable REST ticket
+        env: {GH_TOKEN: '${{ github.token }}'}
+        run: |
+          mkdir -p "$RUNNER_TEMP/handoffs"
+          nohup python3 "$RUNNER_TEMP/csb-engine/scripts/public_ci.py" publisher-server --config .codeshouldbehave/public-ci.json --trusted-root "$GITHUB_WORKSPACE" --plan "$RUNNER_TEMP/plan/plan.json" --budget-manifest "$RUNNER_TEMP/plan/budget.json" --budget-dir "$RUNNER_TEMP/csb-rest-budget" --handoffs "$RUNNER_TEMP/handoffs" --project-root "$RUNNER_TEMP/csb-engine" --verifier "$RUNNER_TEMP/csb-engine/bin/csb-public-report" --work "$RUNNER_TEMP/csb-publisher" --allow-remote-writes >"$RUNNER_TEMP/csb-publisher.log" 2>&1 &
+      - id: stage
