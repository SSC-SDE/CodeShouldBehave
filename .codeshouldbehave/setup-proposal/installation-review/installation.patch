+# Inactive template. Install only after explicit public-source/Pages consent and
+# attested Linux release pins. Never consume artifacts from the nudge run.
+name: CodeShouldBehave public controller
+on:
+  workflow_run:
+    workflows: [CodeShouldBehave nudge]
+    types: [completed]
+  schedule:
+    - cron: '*/10 * * * *'
+  workflow_dispatch:
+permissions: {}
+concurrency:
+  group: csb-public-controller-${{ github.repository_id }}
+  cancel-in-progress: false
+jobs:
+  plan:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    permissions:
+      contents: read
+      actions: read
+      deployments: read
+      attestations: read
+    outputs:
+      matrix: ${{ steps.matrix.outputs.matrix }}
+      count: ${{ steps.matrix.outputs.count }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ github.workflow_sha }}
+          persist-credentials: false
+      - name: Load the attested fixed engine
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: python3 .codeshouldbehave/bootstrap.py --config .codeshouldbehave/public-ci.json --output "$RUNNER_TEMP/csb-engine"
+      - name: Resolve current provider identities and bounded queue
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          python3 "$RUNNER_TEMP/csb-engine/scripts/public_ci.py" github-plan --config .codeshouldbehave/public-ci.json --trusted-root "$GITHUB_WORKSPACE" --output "$RUNNER_TEMP/plan.json" --budget-dir "$RUNNER_TEMP/csb-rest-budget" --budget-output "$RUNNER_TEMP/budget.json" --budget-snapshot "$RUNNER_TEMP/plan-budget.json"
+          python3 "$RUNNER_TEMP/csb-engine/scripts/public_ci.py" prepare-matrix --plan "$RUNNER_TEMP/plan.json" --output "$RUNNER_TEMP/requests"
+      - id: matrix
+        name: Publish source-free matrix metadata
+        run: |
+          python3 - <<'PY'
+          import json,os
+          from pathlib import Path
+          value=json.loads((Path(os.environ['RUNNER_TEMP'])/'requests/matrix.json').read_text())
+          with open(os.environ['GITHUB_OUTPUT'],'a') as output:
+              output.write('matrix='+json.dumps(value,separators=(',',':'))+'\ncount='+str(len(value['include']))+'\n')
+          PY
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
